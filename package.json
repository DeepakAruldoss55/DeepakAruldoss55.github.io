{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://DeepakAruldoss55.github.io/",
  "proxy": "http://127.0.0.1:8000",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "aos": "^2.3.4",
    "bootstrap": "^5.3.3",
    "cra-template": "1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-router-dom": "^6.30.0",
    "react-scripts": "^5.0.1",
    "react-scroll": "^1.9.2",
    "swiper": "^11.2.4",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "backend": "cd rag-backend && ./venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "dev": "concurrently -n \"REACT,FASTAPI\" -c \"cyan,magenta\" \"react-scripts start\" \"npm run backend\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "build": "react-scripts build && cp build/index.html build/404.html",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "gh-pages": "^6.3.0"
  }
}
