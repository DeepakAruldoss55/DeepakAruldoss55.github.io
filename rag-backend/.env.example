# LLM Provider Configuration
# Options: "ollama", "openai_compatible"
LLM_PROVIDER=ollama

# Option 1: Local via Ollama (Qwen)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Option 2: OpenAI-compatible Cloud API (e.g., Groq / OpenRouter / HuggingFace)
# For Groq (Ultra-fast & free tier):
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_your_groq_key_here
# OPENAI_MODEL=qwen-2.5-32b

# For OpenRouter:
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=your_openrouter_api_key
# OPENAI_MODEL=qwen/qwen-2.5-7b-instruct:free

# Vector DB configuration
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Server Port
PORT=8000

